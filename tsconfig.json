{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "units/**/*.ts",
    "units/**/*.tsx",
    "shell/**/*.ts",
    "shell/**/*.tsx",
    "kit/**/*.ts",
    "kit/**/*.tsx",
    "data/aggregates/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "tests/**/*.ts"
  ]
}
