        {
          "id": "mode-fields",
          "description": "En mode « api », url et detected_api_type sont renseignés et binary est vide. En mode « binaire », binary vaut exactement « opencode » ou « claude-code » et url est vide."
        },
        {
          "id": "api-type-recognized",
          "description": "Une URL dont le type d'API n'est pas reconnu ne peut pas être enregistrée. Le test la refuse avec le message « type d'API non reconnu »."
        },
        {
          "id": "test-does-not-save",
          "description": "« Tester la connexion » n'écrit que les champs last_test_*. Il n'enregistre jamais URL, modèles ni mode, donc aucun réglage invalide n'est enregistré à l'insu du DM."
        },
        {
          "id": "single-settings-row",
          "description": "Il existe une seule ligne ai_settings (id = 1), et elle pointe vers un fournisseur existant."
        },
        {
          "id": "text-only-payload",
          "description": "Toute requête vers le fournisseur actif, API ou binaire, ne porte que du texte : prompts transcrits, briefs, notes, journal. Jamais d'audio."
        }
      ],
      "criticality": "high"
    },
    {
      "name": "BattlemapInstance",
      "root": "battlemap_instance",
      "entities": ["token", "combat", "initiative_entry", "initiative_order_view"],
      "invariants": [
        {
          "id": "instance-isolated",
          "description": "Les tokens, PV, états et le combat appartiennent à l'instance. La battlemap d'origine et sa grille ne sont jamais modifiées par une instance."
        },
        {
          "id": "one-instance-per-scene",
          "description": "Une scène a au plus une instance de battlemap. La battlemap d'origine est liée à la scène et appartient à la campagne de la séance."
        },
        {
          "id": "token-roster",
          "description": "Un PJ ne peut être posé que s'il est présent à la séance, et un PJ n'a qu'un token par instance."
        },
        {
          "id": "multi-drop-numbering",
          "description": "Déposer un personnage « × n » crée n tokens numérotés à la suite des numéros déjà pris pour ce personnage (1 à n la première fois). Les numéros sont uniques par instance et par personnage. Renommer un token ne touche que lui."
        },
        {
          "id": "pj-hp-not-tracked",
          "description": "hp_current et hp_max restent vides pour un token de PJ. Pour un PNJ, hp_max est copié de la fiche à la pose et 0 ≤ hp_current ≤ hp_max."
        },
        {
          "id": "hp-change-one-token",
          "description": "Un changement de PV ne touche que le token visé, jamais les autres instances du même personnage."
        },
        {
          "id": "dead-derived",
          "description": "Un PNJ est mort si et seulement si ses PV courants valent 0. Il est alors grisé et sauté par « Suivant »."
        },
        {
          "id": "players-see-band-only",
          "description": "La player view ne reçoit que health_band : jamais de chiffre de PV, jamais de notes, jamais de token caché."
        },
        {
          "id": "npc-initiative-bounds",
          "description": "Pour un PNJ, roll est entre 1 et 20 et initiative = roll + modificateur de DEX. Pour un PJ, roll est vide et initiative est saisie par le DM."
        },
        {
          "id": "initiative-tiebreak",
          "description": "Au lancement, rank suit l'initiative décroissante, puis la DEX décroissante, puis le tirage aléatoire."
        },
        {
          "id": "hidden-keeps-rank",
          "description": "Un token caché garde son rank. Le révéler ne change ni son rang ni celui des autres participants."
        },
        {
          "id": "next-turn",
          "description": "« Suivant » passe au prochain participant vivant dans l'ordre des rangs. Il incrémente le round quand il revient au premier."
        },
        {
          "id": "one-active-combat",
          "description": "Une instance a au plus un combat sans ended_at."
        },
        {
          "id": "state-persisted-reset",
          "description": "Positions, PV, états et initiative sont persistés à chaque action et identiques après réouverture. « Réinitialiser la carte » supprime tokens, combat et initiative de l'instance."
        },
        {
          "id": "single-position-source",
          "description": "La position (q, r) d'un token est la seule source pour la DM view et la player view. Le dépôt est diffusé aux onglets en moins d'une seconde, et la distance affichée pendant le glisser vaut la distance hex entre l'origine et le curseur, multipliée par 5 pieds."
        }
      ],
      "criticality": "high"
    },
