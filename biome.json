{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!mock",
      "!.harness",
      "!vendor",
      "!app/shell/dist",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true
  },
  "json": {
    "formatter": {
      "enabled": false
    }
  }
}
