{
  "id": "campaign.importCampaign",
  "kind": "data-capability",
  "title": "Importer une campagne",
  "description": "Reads an archive and always creates a new campaign with new ids, the original untouched (import-creates-copy).",
  "aggregate": "Campaign",
  "touches": [
    "campaign.name",
    "campaign.kind",
    "campaign.pitch",
    "campaign.art",
    "campaign.glyph",
    "campaign.cover_media_id",
    "campaign.created_at",
    "campaign.imported_at",
    "campaign.origin_campaign_id",
    "campaign.sound_master_volume"
  ],
  "input": {
    "archive": "file"
  }
}
